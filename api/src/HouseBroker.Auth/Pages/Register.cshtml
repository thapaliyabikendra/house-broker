@page
@model HouseBroker.Auth.Pages.RegisterModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-header">
            <h3 class="text-center">@Model.Title</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">@Model.EmailLabel</label>
                    <input asp-for="Input.Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">@Model.PasswordLabel</label>
                    <input asp-for="Input.Password" class="form-control" type="password" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">@Model.ConfirmPasswordLabel</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Role" class="form-label">@Model.RoleLabel</label>
                    <select asp-for="Input.Role" class="form-select">
                        <option value="Seeker">Seeker</option>
                        <option value="Broker">Broker</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label">@Model.FullNameLabel</label>
                    <input asp-for="Input.FullName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.PhoneNumber" class="form-label">@Model.PhoneLabel</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">@Model.ButtonText</button>
            </form>
        </div>
    </div>
</div>
