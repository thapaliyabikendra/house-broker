@page
@model HouseBroker.Auth.Pages.AccessDeniedModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<HouseBroker.Auth.Resources.Resources> L
@{
    ViewData["Title"] = L["AccessDenied_Title"];
}

<div class="container mt-5">
    <div class="card mx-auto text-center shadow-sm" style="max-width: 500px;">
        <div class="card-body">
            <h1 class="h3">@L["AccessDenied_Title"]</h1>
            <p class="text-muted">@L["AccessDenied_Message"]</p>
            <a asp-page="/Index" class="btn btn-primary">@L["AccessDenied_Back"]</a>
        </div>
    </div>
</div>