@page
@model ErrorModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<HouseBroker.Auth.Resources.Resources> L
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = L["Error_Title"];
}

<div class="container mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 600px;">
        <div class="card-body text-center">
            <h1 class="text-danger h3">@L["Error_Title"]</h1>
            <p class="text-danger">@L["Error_Heading"]</p>
            <p class="text-muted">@L["Error_Body"]</p>
            @if (Model.ShowRequestId)
            {
                <p class="mb-0"><strong>@L["Error_RequestId"]:</strong> <code>@Model.RequestId</code></p>
            }
            @if (Env.IsDevelopment())
            {
                <p class="text-muted small mt-3">@L["Error_Development"]</p>
            }
        </div>
    </div>
</div>