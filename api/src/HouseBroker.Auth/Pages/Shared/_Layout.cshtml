@inject Microsoft.Extensions.Localization.IStringLocalizer<HouseBroker.Auth.Resources.Resources> L
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["Brand_Name"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HouseBroker.Auth.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" aria-label="@L["Nav_Home"]">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">@L["Brand_Name"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="nav navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Login">@L["Home_SignIn"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">@L["Nav_Privacy"]</a>
                        </li>
                        <li class="nav-item">
                            @* Public listings live in the Angular portal served at the gateway root, outside the /sso/ path base. *@
                            <a class="nav-link text-dark" href="/search">@L["Nav_Portal"]</a>
                        </li>
                    </ul>
                    <div class="ms-sm-auto d-flex gap-2 align-items-center">
                        <form method="get" id="lang-form" class="d-flex align-items-center gap-2">
                            <label class="visually-hidden" for="lang-select">@L["Nav_Language"]</label>
                            @* Keep every other query parameter (for example returnUrl) when the language changes. *@
                            @foreach (var pair in Context.Request.Query.Where(q => q.Key is not ("culture" or "ui-culture")))
                            {
                                foreach (var value in pair.Value)
                                {
                                    <input type="hidden" name="@pair.Key" value="@value" />
                                }
                            }
                            <select id="lang-select" name="culture" class="form-select form-select-sm lang-switch__select">
                                <option value="en" lang="en" selected="@(currentCulture.StartsWith("en") ? "selected" : null)">@L["Language_English"]</option>
                                <option value="ne" lang="ne" selected="@(currentCulture.StartsWith("ne") ? "selected" : null)">@L["Language_Nepali"]</option>
                            </select>
                            <noscript>
                                <button type="submit" class="btn btn-sm btn-outline-primary">@L["Language_Apply"]</button>
                            </noscript>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @L["Brand_Name"]
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>