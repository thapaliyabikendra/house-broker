@page
@model HouseBroker.Auth.Pages.ConsentModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<HouseBroker.Auth.Resources.Resources> L
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="card mx-auto shadow-sm" style="max-width: 600px;">
        <div class="card-header">
            <h3 class="text-center">@Model.Title</h3>
        </div>
        <div class="card-body">
            <p>@L["Consent_ClientRequesting"]</p>
            <p class="mb-2">@Model.Intro</p>
            <h2 class="h6">@L["Consent_ScopeHeading"]</h2>
            <ul class="list-group mb-3">
                @foreach (var scope in Model.Scopes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@Model.DescribeScope(scope)</span>
                        <code class="small text-muted">@scope</code>
                    </li>
                }
            </ul>
            <p class="text-muted small">@L["Consent_DenyResult"]</p>
            <div class="d-flex justify-content-end gap-2">
                <form method="post" asp-page-handler="Deny">
                    <button type="submit" class="btn btn-secondary">@Model.DenyText</button>
                </form>
                <form method="post" asp-page-handler="Allow">
                    <button type="submit" class="btn btn-primary">@Model.AllowText</button>
                </form>
            </div>
        </div>
    </div>
</div>