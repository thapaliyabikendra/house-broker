@page
@model PrivacyModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<HouseBroker.Auth.Resources.Resources> L
@{
    ViewData["Title"] = L["Privacy_Title"];
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3">@L["Privacy_Title"]</h1>
            <p>@L["Privacy_Body"]</p>
            <p class="text-muted small">House Broker</p>
        </div>
    </div>
</div>