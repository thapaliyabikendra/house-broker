<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  <NoWarn>$(NoWarn);CA1515;CA1062;CA1859;CA1307;IDE0005;CA1849;AV0029;AV0030;AV0015;AV0013;AV0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Authorization" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HouseBroker.Application\HouseBroker.Application.csproj" />
    <ProjectReference Include="..\..\src\HouseBroker.Application.Contracts\HouseBroker.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\src\HouseBroker.Infrastructure\HouseBroker.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\HouseBroker.ServiceDefaults\HouseBroker.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup><PackageReference Include="System.Security.Cryptography.Pkcs" /></ItemGroup>
</Project>


