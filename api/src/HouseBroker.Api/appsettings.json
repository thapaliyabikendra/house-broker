{
  "ConnectionStrings": {
    "HouseBroker": "Server=localhost,1433;Database=HouseBroker;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },
  "PathBase": "/api",
  "FeatureManagement": {
    "ImageUploads": true
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Search": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Upload": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}