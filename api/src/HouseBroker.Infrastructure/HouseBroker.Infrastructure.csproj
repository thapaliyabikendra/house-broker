<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  <NoWarn>$(NoWarn);CA1062;CA1861;CA2008;CA1031;CA1823;CA1308;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HouseBroker.Application\HouseBroker.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SeedData\house-apartment.jpg" />
    <EmbeddedResource Include="SeedData\house-house.jpg" />
    <EmbeddedResource Include="SeedData\house-land.jpg" />
    <EmbeddedResource Include="SeedData\house-commercial.jpg" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup><PackageReference Include="System.Security.Cryptography.Pkcs" /></ItemGroup>
</Project>


